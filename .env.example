# ---- 伺服器端 ----------------------------------------------------
# 監聽埠。Render / Railway 之類的平台會自動注入 PORT，本機才需要自己設。
PORT=3030
HOST=0.0.0.0

# 允許連進來的前端來源，逗號分隔。* 代表不限制（僅適合本機開發）。
# 正式環境請填實際網址，例如：https://whack-a-mole.onrender.com
GAME_ALLOWED_ORIGIN=*

# 一局的長度（毫秒）。預設 90 秒，分三階段加速。
ROUND_MS=90000

# 開賽倒數（毫秒）
COUNTDOWN_MS=3000

# 伺服器端 AI 的反應時間倍率。自動化測試會設成 0.15 讓它出手變快。
AI_SPEED_SCALE=1

# ---- 前端 --------------------------------------------------------
# 前端要連的遊戲伺服器位址。前端和伺服器在同一個服務上時可以不用設
# （public/js/config.js 會自動用同源）。要把前端另外放（例如 GitHub Pages）
# 才需要在建置時用 `npm run inject` 把它注入進去。
GAME_SERVER_URL=http://localhost:3030
